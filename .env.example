# Copy to .env and fill in your Firebase web-app values.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=
# Local fingerprint bridge (same PC as the reader). The hosted page calls this.
VITE_BRIDGE_URL=http://127.0.0.1:5050
# Pairing token — only needed if the bridge is configured with ApiTokens.
# Leave empty for the default open demo bridge.
VITE_BRIDGE_TOKEN=
